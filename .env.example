# Copiar a .env.local (gitignored) y completar con los valores reales del
# proyecto Supabase compartido con la app (jhtkvcxvgjwnuzfhbale). Son
# variables públicas por diseño: viajan al browser, la anon key está
# protegida por RLS. No poner acá la service_role key.

VITE_SUPABASE_URL=https://jhtkvcxvgjwnuzfhbale.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SOLO SERVIDOR (funciones en api/). Se configuran en Vercel → Settings →
# Environment Variables. NO llevan prefijo VITE_ (si lo llevaran, viajarían al
# navegador). NO se commitean con valores reales ni van en .env.local del SPA.
# ─────────────────────────────────────────────────────────────────────────────
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://propmatch-crm-taupe.vercel.app/api/meli/callback
# Origen del CRM, sin barra final (a donde se vuelve después de conectar).
APP_URL=https://propmatch-crm-taupe.vercel.app
# 32 bytes en base64. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENC_KEY=
SUPABASE_URL=https://jhtkvcxvgjwnuzfhbale.supabase.co
SUPABASE_ANON_KEY=
# Se saltea RLS: JAMÁS en el navegador ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=

# Proppi (asistente de IA, api/proppi.ts). Solo servidor. También usa
# SUPABASE_URL y SUPABASE_ANON_KEY de arriba para validar la sesión.
ANTHROPIC_API_KEY=
# Opcional. Default claude-haiku-4-5. Con un modelo 5.x (ej. claude-opus-5-5)
# se agregan effort y fallback server-side automáticamente.
PROPPI_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# INBOX UNIFICADO (WhatsApp / Instagram / Messenger)
# Ver docs/inbox-unificado-puesta-en-marcha.md. Faltando cualquiera, la UI
# muestra "Falta configurar" y no rompe.
# ─────────────────────────────────────────────────────────────────────────────
# Navegador (públicas por diseño):
VITE_META_APP_ID=
VITE_META_WA_CONFIG_ID=
VITE_META_MESSAGING_CONFIG_ID=
# "1" recién cuando Meta apruebe pages_messaging / instagram_manage_messages.
VITE_META_MESSAGING_ENABLED=

# Solo servidor:
# Supabase PROPIO del CRM (NO el de la app).
CRM_SUPABASE_URL=
CRM_SUPABASE_SERVICE_ROLE_KEY=
# 32 bytes en base64 (distinta de INTEGRATIONS_ENC_KEY).
INBOX_ENC_KEY=
META_APP_ID=
META_APP_SECRET=
# String largo y aleatorio; el mismo se carga en el App Dashboard → Webhooks.
META_WEBHOOK_VERIFY_TOKEN=
# Opcional. Por defecto v25.0.
META_GRAPH_VERSION=
# "1" para habilitar Instagram/Messenger en el servidor (igual que el VITE_).
META_MESSAGING_ENABLED=
# "1" solo si Meta aprobó el permiso Human Agent (responder hasta 7 días en IG/Messenger).
META_HUMAN_AGENT_ENABLED=
