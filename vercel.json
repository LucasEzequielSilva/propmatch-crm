{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/meli.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/meli/:action",
      "destination": "/api/meli?action=:action"
    },
    {
      "source": "/api/inbox/:action",
      "destination": "/api/inbox?action=:action"
    },
    {
      "source": "/api/whatsapp/:action",
      "destination": "/api/whatsapp?action=:action"
    },
    {
      "source": "/api/meta/:action",
      "destination": "/api/meta?action=:action"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
